    if forward.Magnitude<0.001 then return end
    forward=forward.Unit
    local behind=chosen.root.Position-forward*3
    local point=kind=="knife" and chosen.body.Position or chosen.part.Position
    local origin=Vector3.new(behind.X,point.Y,behind.Z)
    return behind,origin,point
end
function Combat:move(chosen,kind)
    if self.movement or not self:valid(chosen) then return end
    local character=self.host.player.Character
    local root=character:FindFirstChild("HumanoidRootPart")
    local behind,origin,point=self:geometry(chosen,kind)
    if not finite(behind) then return end
    local move={character=character,root=root,before=root.CFrame,linear=root.AssemblyLinearVelocity,
        angular=root.AssemblyAngularVelocity,chosen=chosen,kind=kind,thread=coroutine.running(),beat=self.beats,at=os.clock()}
    self.movement=move
    local ok=pcall(function()
        root.CFrame=CFrame.new(behind,Vector3.new(point.X,behind.Y,point.Z))
        root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero
    end)
    if not ok then self:restore(move) return end
    move.delta=behind-move.before.Position
    move.origin=origin



    return move
end
function Combat:owner(fn)
    local ok,environment=pcall(self.host.getfenv,fn)
    local source=ok and type(environment)=="table" and rawget(environment,"script")
    if typeof(source)~="Instance" then return nil end
    return source
end
function Combat:directShotReader()


    for level=3,48 do
        local ok,fn=pcall(self.host.debug.info,level,"f")
        if not ok or not fn then break end
        if self.readers[fn] then return true end
        local owner=self:owner(fn)
        if owner then
            local named,name=pcall(self.host.debug.info,fn,"n")
            if owner==self.bullets or owner==self.weapons then
                return named and (name=="firebullet" or name=="shootprojectile")
            end
            if named and (name=="CreateProjectile" or name=="doprojectile")
                and owner:GetFullName()=="ReplicatedFirst.Client.Utility.ClientFunctions" then return true end
        end
    end
    return false
