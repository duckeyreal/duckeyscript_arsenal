local function weaponValues(scope, id)
    local weapons = Storage:FindFirstChild("Weapons")
    if not weapons then return false, "The game's Weapons folder is unavailable." end
    local originals = {}
    local function apply(object)
        local matches = id == "recoil" and object.Name == "RecoilControl" or id == "fastshoot" and (object.Name == "FireRate" or object.Name == "BFireRate")
        if not matches or not (object:IsA("NumberValue") or (id == "recoil" and object:IsA("IntValue"))) then return end
        if originals[object] == nil then originals[object] = object.Value end
        local value
        if id == "recoil" then value = originals[object] * (1 - App.config.recoil.reduction / 100)
        elseif object.Name == "BFireRate" and not App.config.fastshoot.burst then value = originals[object]
        else value = App.config.fastshoot.interval end
        scope:set(object, "Value", value)
    end
    for _, object in ipairs(weapons:GetDescendants()) do apply(object) end
    if next(originals) == nil then return false, "No compatible weapon values were found." end
    scope:connect(weapons.DescendantAdded, apply)
    local update = function() for object in pairs(originals) do if object.Parent then apply(object) end end end
    App.callbacks[id] = update
    scope:add(function() if App.callbacks[id] == update then App.callbacks[id] = nil end end)
    return true
end
