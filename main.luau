local Hooks = (function()

local Hooks = {}
Hooks.__index = Hooks
local Methods = { "Raycast", "FindPartOnRayWithIgnoreList", "FindPartOnRayWithWhitelist", "FindPartOnRay" }
local CameraMethods = { "ScreenPointToRay", "ViewportPointToRay" }
local CameraSupported = {}
local Supported = {}
for _, name in ipairs(Methods) do Supported[name] = true end
for _, name in ipairs(CameraMethods) do Supported[name],CameraSupported[name] = true,true end

function Hooks.new(host)
    return setmetatable({
        host = host, active = false, installed = false, destroyed = false,
        busy = setmetatable({}, { __mode = "k" }), installations = {},
    }, Hooks)
end

function Hooks:isWorkspace(object)
    if object == self.host.workspace then return true end
    if type(self.host.compareinstances) == "function" then
        local ok, same = pcall(self.host.compareinstances, object, self.host.workspace)
        return ok and same == true
    end
    return false
end

function Hooks:arguments(method, arguments)
    local host = self.host
    if not self.active or self.destroyed or not Supported[method] then return nil end
    if not host.isFiring() then return nil end
    local origin, direction
    if method == "Raycast" then
        if host.typeof(arguments[1]) ~= "Vector3" or host.typeof(arguments[2]) ~= "Vector3" then
            return nil
        end
        origin, direction = arguments[1], arguments[2]
    else
        if host.typeof(arguments[1]) ~= "Ray" then return nil end
        if method ~= "FindPartOnRay" and type(arguments[2]) ~= "table" then
            return nil
        end
        origin, direction = arguments[1].Origin, arguments[1].Direction
    end
    if direction.Magnitude < 10 then return nil end

    local targetPosition, cameraPosition, rootPosition = host.target()
    if not targetPosition then return nil end
    local nearCamera = cameraPosition and (origin - cameraPosition).Magnitude <= 25
    local nearPlayer = rootPosition and (origin - rootPosition).Magnitude <= 25
    if not nearCamera and not nearPlayer then return nil end
    local redirected = host.redirect(origin, direction, targetPosition)
    if not redirected then return nil end
    local copy = table.clone(arguments)
    if method == "Raycast" then copy[2] = redirected else copy[1] = host.ray(origin, redirected) end
    return copy
end

function Hooks:prepare(method, object, arguments)
    if self.host.checkcaller() or not self:isWorkspace(object) then return nil end
    return self:arguments(method, arguments)
end

function Hooks:cameraTarget(object)
    local host=self.host
    if host.checkcaller() or not host.isFiring() or type(host.camera)~="function" or type(host.aimRayCaller)~="function" then return nil end
    local camera=host.camera()
    if not camera then return nil end
    if object~=camera then
        if type(host.compareinstances)~="function" or not host.compareinstances(object,camera) then return nil end
    end


    if not host.aimRayCaller() then return nil end
    return host.target()
end

function Hooks:cameraRay(ray,point)
    if self.host.typeof(ray)~="Ray" or self.host.typeof(point)~="Vector3" then return nil end
    local origin=type(self.host.launchOrigin)=="function" and self.host.launchOrigin() or ray.Origin
    local delta=point-origin
    local length=ray.Direction.Magnitude
    if delta.Magnitude<=0.0001 or length<=0 or delta.Magnitude>=math.huge or length>=math.huge then return nil end

    return self.host.ray(origin,delta*(length/delta.Magnitude))
end

function Hooks:invoke(original, method, object, ...)
    if not self.destroyed and self.host.combat and self.host.combat.modes.infkniferange
        and Supported[method] and not CameraSupported[method] then
        local handled,result=self.host.combat:cast(original,method,object,...)
        if handled then return table.unpack(result,1,result.n) end
    end
    if not self.active or self.destroyed or not Supported[method] then return original(object, ...) end


    if self.host.checkcaller() or not self.host.isFiring() then return original(object, ...) end
    local thread = coroutine.running()
    if self.busy[thread] then return original(object, ...) end
    self.busy[thread] = true
    local args = table.pack(...)
    local point
    if CameraSupported[method] then
        local ok,target=pcall(self.cameraTarget,self,object)
        if ok then point=target end
    else
        local ok, modified = pcall(self.prepare, self, method, object, args)
        if ok and modified then args = modified end
    end


    local result = table.pack(pcall(original, object, table.unpack(args, 1, args.n)))
    if result[1] and point then
        local ok,ray=pcall(self.cameraRay,self,result[2],point)
        if ok and ray then result[2]=ray end
    end
    self.busy[thread] = nil
    if not result[1] then error(result[2], 0) end
    return table.unpack(result, 2, result.n)
