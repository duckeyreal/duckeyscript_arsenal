local rayParams,rayParamsCamera,rayParamsCharacter
local function exclusionsFor(camera)
    if not rayParams or rayParamsCamera~=camera or rayParamsCharacter~=Player.Character then
        rayParams=RaycastParams.new()
        rayParams.FilterType=Enum.RaycastFilterType.Exclude
        local exclusions={camera,ctx.effects}
