function Schema.set(values: any, id: string, key: string, value: any)
    for _, module in ipairs(Schema.modules :: any) do
        if module.id == id then
            for _, spec in ipairs(module.settings) do
                if spec.key == key then
                    if spec.type == "slider" then
                        value = tonumber(value)
                        if not value or value ~= value then return false end
                        value = math.clamp(math.floor((value - spec.min) / spec.step + 0.5) * spec.step + spec.min, spec.min, spec.max)
                    elseif spec.type == "toggle" then value = value == true
                    elseif spec.type == "choice" then
                        if not table.find(spec.options, value) then return false end
                    elseif spec.type == "color" then
                        value = tostring(value):gsub("#", ""):upper()
                        if not value:match("^%x%x%x%x%x%x$") then return false end
                    else value = tostring(value) end
                    values[id][key] = value
                    if key == "fov" and (id == "silent" or id == "aimbot") then
                        values.silent.fov, values.aimbot.fov = value, value
                    end
                    if id == "silent" and key == "headChance" then values[id].bodyChance = 100 - value end
                    if id == "silent" and key == "bodyChance" then values[id].headChance = 100 - value end
                    return true
                end
            end
        end
    end
    return false
end
return Schema

end)()

local Logic = (function()

local Logic = {}
function Logic.smoothAlpha(dt, degreesPerSecond, angle, smoothing)
    if dt <= 0 then return 0 end
    local ease = 1 - math.exp(-math.clamp(smoothing, 2, 30) * math.min(dt, 0.1))
    local rate = math.rad(degreesPerSecond) * math.min(dt, 0.1) / math.max(angle, 0.0001)
    return math.clamp(math.min(ease, rate), 0, 0.85)
end
function Logic.chooseHead(chance, roll) return roll < math.clamp(chance, 0, 100) / 100 end
function Logic.gate(state, target, now, delay)
    if not target then state.target, state.since = nil, nil return false end
    if state.target ~= target then state.target, state.since = target, now end
    return now - state.since >= delay
end
function Logic.fade(start, now, duration, opacity)
    return 1 - opacity * (1 - math.clamp((now - start) / math.max(duration, 0.01), 0, 1))
end
return Logic

end)()

