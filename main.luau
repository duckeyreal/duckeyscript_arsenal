        if not humanoid or humanoid.Health<=0 then return end
        local ammo=binding.state.ammocount
        if type(ammo)~="number" then return end
        local key=tostring(ctx.adapter:weaponName())..":"..tostring(binding.state.selectedweapon)..":"..tostring(ammo)
