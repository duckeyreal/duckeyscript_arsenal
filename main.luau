    end
    scope:render(ctx.run,function()
        local camera,cfg=workspace.CurrentCamera,ctx.config.afterimage
        if not camera then reset(true) table.clear(known) return end
        local now,parts,seen=os.clock(),{},{}
        for _,kind in ipairs({"hands","weapon"}) do
            if (kind=="hands" and cfg.hands) or (kind=="weapon" and cfg.items) then
                for _,part in ipairs(ctx.adapter:parts(kind)) do
                    local visible=part.Transparency<0.98 and part.LocalTransparencyModifier<0.98
