        corner(rail, 2)
        local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.yellow, BorderSizePixel = 0 }, rail)
        corner(fill, 2)
        local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.yellow, BorderSizePixel = 0 }, rail)
        corner(knob, 5)
        local drag
        local function move(x)
            if rail.AbsoluteSize.X > 0 then set(spec.min + math.clamp((x - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1) * (spec.max - spec.min)) end
        end
        scope:connect(track.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then drag = input move(input.Position.X) end
        end)
        scope:connect(self.ctx.input.InputChanged, function(input)
            if drag and self.open and parent.Visible and (input == drag or (drag.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then move(input.Position.X) end
        end)
        scope:connect(self.ctx.input.InputEnded, function(input)
            if input == drag or input.UserInputType == Enum.UserInputType.MouseButton1 then drag = nil end
        end)
        scope:connect(self.ctx.input.WindowFocusReleased, function() drag = nil end)
        scope:connect(self.window:GetPropertyChangedSignal("Visible"), function() if not self.open then drag = nil end end)
        scope:connect(parent:GetPropertyChangedSignal("Visible"), function() if not parent.Visible then drag = nil end end)
        table.insert(refreshers, function()
            local n = tonumber(value()) or spec.min
            local a = (n - spec.min) / (spec.max - spec.min)
            amount.Text = (spec.step < 1 and string.format("%.2f", n) or tostring(math.floor(n + 0.5))) .. spec.suffix
            fill.Size, knob.Position = UDim2.fromScale(a, 1), UDim2.fromScale(a, 0.5)
        end)
    elseif spec.type == "toggle" then
        local control = button(row, "", { Position = UDim2.new(1, -64, 0, 0), Size = UDim2.fromOffset(64, 27) })
        scope:connect(control.Activated, function() set(not value()) end)
        table.insert(refreshers, function() control.Text = value() and "ON" or "OFF" control.TextColor3 = value() and C.yellow or C.muted end)
    elseif spec.type == "color" or spec.type == "text" then
        local field = make("TextBox", { Name = "Value", Position = UDim2.new(0.55, 0, 0, 0), Size = UDim2.new(0.45, 0, 0, 28),
            Text = tostring(value()), PlaceholderText = spec.type == "color" and "#FFD54A" or "Auto detect", ClearTextOnFocus = false,
            BackgroundColor3 = C.panel, BorderSizePixel = 0, TextColor3 = C.text, TextSize = 12, Font = Enum.Font.GothamMedium }, row)
        corner(field, 5)
        scope:connect(field.FocusLost, function() set(field.Text) self:Refresh() end)
        table.insert(refreshers, function()
            if not field:IsFocused() then field.Text = tostring(value()) end
            if spec.type == "color" then title.TextColor3 = UI.color(value()) end
        end)
    else
        local select = button(row, "", { Name = "Select", Position = UDim2.new(0.52, 0, 0, 0), Size = UDim2.new(0.48, 0, 0, 28), TextTruncate = Enum.TextTruncate.AtEnd })
        local arrow=icon(select,"chevron",14,C.muted) arrow.Position=UDim2.new(1,-20,0,7)
        local options = make("Frame", { Name = "Options", Position = UDim2.fromOffset(0, 37), Size = UDim2.new(1, 0, 0, 182), BackgroundColor3 = C.panel, Visible = false, BorderSizePixel = 0 }, row)
        corner(options, 8)
        local search = make("TextBox", { Name = "Search", Position = UDim2.fromOffset(8, 7), Size = UDim2.new(1, -16, 0, 27),
            BackgroundColor3 = C.card, Text = "", PlaceholderText = "Search...", TextColor3 = C.text, TextSize = 12,
            Font = Enum.Font.GothamMedium, ClearTextOnFocus = false, BorderSizePixel = 0 }, options)
        corner(search, 5)
        local list = make("ScrollingFrame", { Position = UDim2.fromOffset(6, 40), Size = UDim2.new(1, -12, 1, -46),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, ScrollBarImageColor3 = C.yellow,
            CanvasSize = UDim2.fromOffset(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y }, options)
        make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)
        local optionScope
        local function populate(force)
            if optionScope then optionScope:destroy() end
            optionScope = Core.Scope.new()
            local choices = spec.options or self.ctx.catalog(spec.catalog, force)
            local query, count = search.Text:lower(), 0
            for _, item in ipairs(choices) do
                local name, key = type(item) == "table" and item.name or item, type(item) == "table" and item.id or item
                if name:lower():find(query, 1, true) then
                    count += 1
                    local b = optionScope:own(button(list, name, { Size = UDim2.new(1, -4, 0, 27), LayoutOrder = count, TextTruncate = Enum.TextTruncate.AtEnd }))
                    optionScope:connect(b.Activated, function() set(key) options.Visible = false row.Size = UDim2.new(1, 0, 0, 36) end)
                end
            end
            if count == 0 then optionScope:own(label(list, "No matching assets loaded", 12, C.muted)) end
        end
        scope:add(function() if optionScope then optionScope:destroy() end end)
        scope:connect(select.Activated, function()
            options.Visible = not options.Visible
            row.Size = UDim2.new(1, 0, 0, options.Visible and 224 or 36)
            if options.Visible then populate(spec.type == "catalog") end
        end)
        scope:connect(search:GetPropertyChangedSignal("Text"), function() if options.Visible then populate(false) end end)
        table.insert(refreshers, function()
            local v = value()
            local name = v ~= "" and v or "Choose..."
            if spec.type == "catalog" then
                for _, item in ipairs(self.ctx.catalog(spec.catalog, false)) do if item.id == v then name = item.name break end end
            end
            select.Text = name .. "    "
        end)
    end
end

function UI:Select(category)
    if self.pageScope then self.pageScope:destroy() end
    self.pageScope, self.rows, self.category = Core.Scope.new(), {}, category
    if self.ctx.dirty then self.ctx.dirty() end
    self.heading.Text = category
    self.list.CanvasPosition = Vector2.new(0, 0)
    for name, nav in pairs(self.nav) do
        local selected = name == category
        nav.button.BackgroundTransparency, nav.bar.Visible = selected and 0.1 or 1, selected
        nav.name.TextColor3 = selected and C.yellow or C.muted
        nav.tint(selected and C.yellow or C.muted)
    end
    for order, module in ipairs(self.schema.modules) do
        if module.category == category then
            local card = self.pageScope:own(make("Frame", { Name = module.id, Size = UDim2.new(1, -4, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = C.card, BackgroundTransparency = 0.25, BorderSizePixel = 0, LayoutOrder = order }, self.list))
            corner(card, 10)
            local border = stroke(card)
            make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, card)
