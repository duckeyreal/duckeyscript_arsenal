                if type(ctx.debug.info)=="function" then local good,n=pcall(ctx.debug.info,fn,"a") if good then argc=n end
                elseif type(ctx.debug.getinfo)=="function" then local good,info=pcall(ctx.debug.getinfo,fn) if good then argc=info.numparams end end
