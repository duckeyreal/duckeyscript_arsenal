                        while parent and parent~=copy do table.insert(names,1,parent.Name) parent=parent.Parent end
                        local source=part
                        for _,name in ipairs(names) do source=source and source:FindFirstChild(name) end
                        if source then table.insert(dynamic,{source=source,copy=child,bone=child:IsA("Bone")}) end
                    end
