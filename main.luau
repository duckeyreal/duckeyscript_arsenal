local function visible(character, point)
    local camera = workspace.CurrentCamera
    if not camera then return false end
    local params = exclusionsFor(camera)
    local direction = point - camera.CFrame.Position
    local result = workspace:Raycast(camera.CFrame.Position, direction, params)
    return not result or result.Instance:IsDescendantOf(character)
end
local candidates
local function target(cfg)
    local camera = workspace.CurrentCamera
    if not camera or blocked() then return nil end
    local closest, best = nil, cfg.fov
    local mouse = cursor(camera)
    if not candidates then
        candidates={}
        for _,player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local head = character and character:FindFirstChild("Head")
            local body = character and (character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart"))
            if player~=Player and humanoid and humanoid.Health>0 and head and body then
                table.insert(candidates,{player=player,character=character,head=head,body=body,screen={},visibility={}})
            end
        end
    end
    for _,candidate in ipairs(candidates) do
        local player,character,head,body=candidate.player,candidate.character,candidate.head,candidate.body
        if not teammate(player,cfg) then
            local part=cfg.part=="Body" and body or head
            if not candidate.screen[part] then
                candidate.screen[part]=table.pack(Fov.project(ctx,camera,part.Position))
            end
            local projected,onScreen=table.unpack(candidate.screen[part])
            local distance = (Vector2.new(projected.X, projected.Y) - mouse).Magnitude
            local inRange=onScreen and projected.Z>0 and distance<best
            if inRange and cfg.wallCheck and candidate.visibility[part]==nil then
                candidate.visibility[part]=visible(character,part.Position)
            end
            if inRange and (not cfg.wallCheck or candidate.visibility[part]) then
                best = distance
                closest = { player = player, character = character, part = part, head = head, body = body }
            end
        end
    end
    return closest
end
