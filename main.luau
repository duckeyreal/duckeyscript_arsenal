local function crosshairTarget(cfg)
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local mouse = cursor(camera)
    local ray = Fov.ray(ctx,camera,mouse.X,mouse.Y)
    local params = exclusionsFor(camera)
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if not hit then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local h = character and character:FindFirstChildOfClass("Humanoid")
        if player ~= Player and h and h.Health > 0 and not teammate(player, cfg) and hit.Instance:IsDescendantOf(character) then return player end
    end
    return nil
end
local function frame(dt)
    ctx.meshFrame=(ctx.meshFrame or 0)+1
    local now, camera = os.clock(), workspace.CurrentCamera
    candidates=nil
    App.rayCamera=camera
    if enabled("silent") and (not App.aimRaySourceAt or now>=App.aimRaySourceAt) then
        App.aimRaySourceAt=now+1
        App.aimRaySources={}
        local modules=Storage:FindFirstChild("Modules")
        local mouse=modules and modules:FindFirstChild("NewMouse")
        if mouse then App.aimRaySources[mouse]=true end
        local first=game:FindFirstChild("ReplicatedFirst")
        local client=first and first:FindFirstChild("Client")
        local clientGame=client and client:FindFirstChild("Game")
        local projectiles=clientGame and clientGame:FindFirstChild("BulletsAndProjectiles")
        if projectiles then App.aimRaySources[projectiles]=true end
    end
    if App.mouseHeld and now >= App.mouseReleaseAt then releaseMouse() end
    if not camera then App.silentSnapshot = {} return end
    local active=enabled("silent") or enabled("aimbot") or enabled("trigger")
    local mouse=active and cursor(camera)
    for id, circle in pairs(circles) do
        local cfg = App.config[id]
        local show=enabled(id) and cfg.fovStyle~="Invisible"
        if circle.frame.Visible~=show then circle.frame.Visible=show end
        if show then
            if circle.x~=mouse.X or circle.y~=mouse.Y then
                circle.x,circle.y=mouse.X,mouse.Y
                circle.frame.Position=UDim2.fromOffset(mouse.X,mouse.Y)
            end
            if circle.fov~=cfg.fov then circle.fov=cfg.fov circle.frame.Size=UDim2.fromOffset(cfg.fov*2,cfg.fov*2) end
            local rainbow=cfg.fovStyle=="Rainbow"
            if circle.gradient.Enabled~=rainbow then circle.gradient.Enabled=rainbow end
            if rainbow then circle.gradient.Rotation=(now*70*(cfg.circleSpeed or 1))%360 end
        end
    end
    if not active then return end
    local paused=blocked()
    if not paused and Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then App.fireUntil = now + 0.25 end
    local silentTarget = enabled("silent") and target(App.config.silent) or nil
    App.silentSnapshot = {}
    if silentTarget then
        local root = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
        local enemyRoot=silentTarget.character:FindFirstChild("HumanoidRootPart")
        App.silentSnapshot = { at = now, head = silentTarget.head.Position, body = silentTarget.body.Position,
            camera = camera.CFrame.Position, root = root and root.Position,player=silentTarget.player,
            character=silentTarget.character,humanoid=silentTarget.character:FindFirstChildOfClass("Humanoid"),
            enemyRoot=enemyRoot,headPart=silentTarget.head,bodyPart=silentTarget.body }
    end
    if enabled("aimbot") then
        local cfg = App.config.aimbot
        local chosen = not paused and (not cfg.holdRight or Input:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) and target(cfg) or nil
        if Logic.gate(App.aimState, chosen and chosen.player, now, cfg.reaction / 1000) then
            local difference = chosen.part.Position - camera.CFrame.Position
            if difference.Magnitude > 0.001 then
                local angle = math.acos(math.clamp(camera.CFrame.LookVector:Dot(difference.Unit), -1, 1))
                local alpha = Logic.smoothAlpha(dt, cfg.flickSpeed, angle, cfg.smoothing)
                camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, chosen.part.Position), alpha)
            end
        end
    end
    if enabled("trigger") then
        local cfg, state = App.config.trigger, App.triggerState
        local chosen
        if not paused then
            if cfg.silentSupport and enabled("silent") then
                if silentTarget and not teammate(silentTarget.player, cfg) and (not cfg.wallCheck or visible(silentTarget.character, silentTarget.part.Position)) then chosen = silentTarget.player end
            else chosen = crosshairTarget(cfg) end
        end
        if Logic.gate(state, chosen, now, cfg.delay / 1000) and not App.mouseHeld and now >= (state.next or 0) then
            App.fireUntil = now + cfg.hold / 1000 + 0.25
            local ok = pcall(mouse1press)
            if ok then
                App.mouseHeld, App.mouseReleaseAt, state.next = true, now + cfg.hold / 1000, now + math.max(cfg.interval, cfg.hold) / 1000
            else App.modules:set("trigger", false) notify("Triggerbot could not press the mouse.") end
        end
        if not chosen then releaseMouse() end
    end

end
