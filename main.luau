function Hooks:install()
    if self.destroyed then return false, "Silent aim is closed" end
    if self.installed then return true end
    local host = self.host
    if type(host.checkcaller) ~= "function" then
        return false, "This executor does not expose checkcaller; silent aim is unavailable."
    end
    local wrap = type(host.newcclosure) == "function" and host.newcclosure or function(fn) return fn end
    local namecallInstalled, functionCount = false, 0
    if type(host.hookmetamethod) == "function" and type(host.getnamecallmethod) == "function" then
        pcall(function()
            local original
            local replacement = wrap(function(object, ...)
                if self.destroyed or (not self.active and not (host.combat and host.combat.modes.infkniferange)) then return original(object, ...) end
                local method = host.getnamecallmethod()
                if not Supported[method] then return original(object, ...) end
                if type(host.setnamecallmethod)=="function" and not self.setterFailed then
                    return self:invoke(function(receiver,...)
                        local restored=pcall(host.setnamecallmethod,method)
                        if restored then return original(receiver,...) end
                        self.setterFailed=true
                        local direct=self.functions and self.functions[method] or receiver[method]
                        return direct(receiver,...)
                    end,method,object,...)
                end


                local direct=self.functions and self.functions[method] or object[method]
                if type(direct)~="function" then return original(object,...) end
                return self:invoke(direct, method, object, ...)
            end)
            original = host.hookmetamethod(host.game, "__namecall", replacement)
            assert(type(original) == "function", "hookmetamethod did not return the original function")
            self.original, self.replacement = original, replacement
            self.installations.namecall = true
            namecallInstalled = true
        end)
    end

    if type(host.hookfunction) == "function" then
        local function installFunctions(object,methods)
            if not object then return end
            for _, method in ipairs(methods) do
                pcall(function()
                    local fn = object[method]
                    assert(type(fn) == "function", "method unavailable")
                    local original
                    local replacement = wrap(function(receiver, ...)
                        return self:invoke(original, method, receiver, ...)
                    end)
                    original = host.hookfunction(fn, replacement)
                    assert(type(original) == "function", "hookfunction did not return the original function")
                    self.functions=self.functions or {} self.functions[method]=original
                    self.installations[method] = true
                    functionCount += 1
                end)
            end
        end
        installFunctions(host.workspace,Methods)
        if type(host.camera)=="function" then installFunctions(host.camera(),CameraMethods) end
    end
    self.installed = namecallInstalled or functionCount > 0
    self.kind = namecallInstalled and (functionCount > 0 and "combined" or "namecall") or "function"
    if self.installed then return true end
    return false, "No ray hooks installed. This executor cannot activate silent aim."
end

function Hooks:enable(scope)
    local ok, reason = self:install()
    if not ok then return false, reason end
    self.active = true
    scope:add(function() self.active = false end)
    return true
end

function Hooks:destroy()
    if self.destroyed then return end
    self.active, self.destroyed = false, true
    local host = self.host


    if self.installations.namecall and type(host.getrawmetatable) == "function" then
        pcall(function()
            if host.getrawmetatable(host.game).__namecall == self.replacement then
                host.hookmetamethod(host.game, "__namecall", self.original)
            end
        end)
    end
    host.target, host.isFiring, host.redirect, host.camera, host.aimRayCaller = nil, nil, nil, nil, nil
    self.original, self.replacement = nil, nil
end

return Hooks

end)()

local Models = (function()

local Models = {}
Models.__index = Models
local function norm(value) return value:lower():gsub("[^%w]", "") end
local body = { leftarm=true, rightarm=true, leftupperarm=true, rightupperarm=true, leftlowerarm=true,
    rightlowerarm=true, leftforearm=true, rightforearm=true, lefthand=true, righthand=true, larm=true, rarm=true }
local helpers = { humanoidrootpart=true, rootpart=true, root=true, camera=true, camerapart=true, aimpart=true, aim=true, muzzle=true,
    joint=true, hitbox=true, headhb=true, particlearea=true }
local roots = { arms=true, viewmodel=true, viewmodels=true, firstperson=true, firstpersonarms=true, vmarms=true }
local effects = { bulletholes=true, bulletmarks=true, debris=true, effects=true, projectiles=true, casings=true, tracers=true,
    killeffects=true, ragdolls=true, deathfx=true, particles=true, preload=true, preloads=true }
local function ignored(object,stop)
    local current=object
    while current and current~=stop do
        if current:GetAttribute("DuckeyOwned") or effects[norm(current.Name)] then return true end
        current=current.Parent
    end
    return false
end
local function namedKind(object, stop, weaponName)
    local current = object
    while current and current ~= stop do
        local name = norm(current.Name)
        if body[name] or name:find("glove",1,true) or name:find("sleeve",1,true)
            or name:find("finger",1,true) or name:find("wrist",1,true) or name:find("cuff",1,true) then return "hands" end
        if current ~= object and (name=="gun" or name=="weapon" or name=="melee" or name==weaponName or current:IsA("Tool")) then return "weapon" end
        current = current.Parent
    end
    if norm(object.Name)=="handle" then return "weapon" end
    return nil
end
local function allParts(root)
    local result = {}
    if not root then return result end
    if root:IsA("BasePart") then table.insert(result,root) end
    for _,item in ipairs(root:GetDescendants()) do if item:IsA("BasePart") then table.insert(result,item) end end
    return result
end
Models.allParts = allParts
Models.kind = namedKind
function Models.isHelper(part) return helpers[norm(part.Name)]==true end
local function structural(object)
    return object:IsA("BasePart") or object:IsA("JointInstance") or object:IsA("WeldConstraint")
        or object:IsA("Model") or object:IsA("Folder") or object:IsA("Tool")
end
Models.structural=structural
function Models.observe(root,scope)
    local index={dirty=true}
    local function invalidate(object) if structural(object) then index.dirty=true end end
    scope:connect(root.DescendantAdded,invalidate)
    scope:connect(root.DescendantRemoving,invalidate)
    function index:read()
        if self.dirty then
            self.objects=root:GetDescendants()
            self.parts={}
            if root:IsA("BasePart") then table.insert(self.parts,root) end
            for _,item in ipairs(self.objects) do if item:IsA("BasePart") then table.insert(self.parts,item) end end
            self.dirty=false
        end
        return self.parts,self.objects
    end
    return index
