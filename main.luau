        local a,b,c,d = raw:byte(i,i+3)
        local value = numbers[a]*262144 + numbers[b]*4096 + (numbers[c] or 0)*64 + (numbers[d] or 0)
        local x,y,z = math.floor(value/65536)%256, math.floor(value/256)%256, value%256
        chunks[#chunks+1] = c == 61 and string.char(x) or d == 61 and string.char(x,y) or string.char(x,y,z)
    end
    return table.concat(chunks)
end
function Asset.load(kind)
    kind = kind or "logo"
    if cache[kind] then return cache[kind] end
    if type(getcustomasset) ~= "function" or type(writefile) ~= "function" then
        return nil, "Embedded textures require writefile/getcustomasset."
    end
    local entry = data[kind]
    if not entry then return nil, "Unknown embedded texture." end
    local ok, result = pcall(function()
        if type(isfile) ~= "function" or not isfile(entry.path) then writefile(entry.path, decode(entry.encoded)) end
        return getcustomasset(entry.path)
    end)
    if ok then cache[kind] = result return result end
    return nil, "The embedded " .. kind .. " texture could not be loaded."
end
return Asset

end)()

