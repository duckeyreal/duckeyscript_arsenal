    local function value() return self.ctx.config[module.id][spec.key] end
    local function set(v)
        if self.ctx.change(module.id, spec.key, v) then self:Refresh() end
    end
    if spec.type == "slider" then
        local amount = label(row, "", 12, C.yellow, { Size = UDim2.new(0.44, 0, 0, 24), Position = UDim2.fromScale(0.56, 0), TextXAlignment = Enum.TextXAlignment.Right })
        local track = button(row, "", { Name = "Track", Position = UDim2.fromOffset(0, 25), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 })
