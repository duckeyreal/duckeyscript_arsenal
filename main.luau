        for part in pairs(known) do if not seen[part] then geometryChanged=true end end
        local projectionChanged=camera~=lastCamera or camera.ViewportSize~=lastSize or Fov.effective(ctx,camera)~=lastFov
        if geometryChanged or projectionChanged then reset(geometryChanged) end
        if geometryChanged then
            stableAt=#parts>12 and now+0.05 or now
            geometryScope:destroy() geometryScope=Core.Scope.new() geometryDirty=false
            for _,part in ipairs(parts) do
                local function invalidate(item)
                    if item:IsA("DataModelMesh") or item:IsA("Bone") then geometryDirty=true end
                end
                geometryScope:connect(part.DescendantAdded,invalidate)
                geometryScope:connect(part.DescendantRemoving,invalidate)
