        local camera=workspace.CurrentCamera
        if camera and self:valid(chosen) then



            self.knifePlan={kind="knife",chosen=chosen,camera=camera,frame=camera.CFrame}
        end
    end
    if knife then return original(...) end
    local chosen=h.target()
    if not self:valid(chosen) then return original(...) end
    local thread=coroutine.running()
    local previous=self.shots[thread]
    local camera=workspace.CurrentCamera
    if not camera then return original(...) end
    local shot={chosen=previous and previous.chosen or chosen,camera=camera,frame=previous and previous.frame or camera.CFrame,
        move=previous and previous.move}
    local generation=self.generation
