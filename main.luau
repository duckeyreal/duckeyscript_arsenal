local Paint = (function()

local Paint = {}
Paint.__index = Paint
function Paint.new(ctx,scope,priority)
    local self=setmetatable({ctx=ctx,entries={},priority=priority or 40},Paint)
    scope:add(function() for _,entry in pairs(self.entries) do entry.scope:destroy() end table.clear(self.entries) end)
    return self
end
function Paint:begin() self.seen={} end
function Paint:apply(part,color,cfg,now)
    if not part.Parent then return end
    self.seen[part]=true
    local entry=self.entries[part]
    if not entry then
        if part.Transparency>=1 then return end
        entry={scope=Core.Scope.new(),owner={},detached={},fields={},childrenDirty=true,clothesAt=-math.huge}
        self.entries[part]=entry
        entry.scope:add(function() self.ctx.layers:remove(entry.owner) end)
        local function invalidate() entry.childrenDirty=true end
        entry.scope:connect(part.ChildAdded,invalidate)
        entry.scope:connect(part.ChildRemoved,invalidate)
    end
    local layers,owner=self.ctx.layers,entry.owner
    local function set(object,key,value) return layers:set(owner,object,key,value,self.priority) end
    set(part,"Color",color)
    set(part,"MaterialVariant","")
    set(part,"Material",cfg.style=="Glass" and Enum.Material.Glass or Enum.Material.SmoothPlastic)
    set(part,"Reflectance",cfg.style=="Glass" and 0.12 or 0)
    set(part,"Transparency",cfg.style=="Glass" and math.max(0.35,1-cfg.opacity) or 1-cfg.opacity)
    if part:IsA("UnionOperation") then set(part,"UsePartColor",true) end
    local texture=cfg.style=="Galaxy" and self.ctx.texture("galaxy") or ""
    texture=texture or ""
    if part:IsA("MeshPart") then set(part,"TextureID",texture) end
    local special=false
    if entry.childrenDirty then entry.children=part:GetChildren() entry.childrenDirty=false end
    for _,child in ipairs(entry.children) do
        if child:IsA("SpecialMesh") then
            special=true set(child,"TextureId",texture)
            set(child,"VertexColor",Vector3.new(color.R,color.G,color.B))
        elseif child:IsA("SurfaceAppearance") then
            entry.detached[child]=true set(child,"Parent",nil)
        elseif (child:IsA("Texture") or child:IsA("Decal")) and not child:GetAttribute("DuckeyPaint") then
            set(child,"Transparency",1)
        end
    end
    for surface in pairs(entry.detached) do
        if not set(surface,"Parent",nil) then entry.detached[surface]=nil layers:forget(owner,surface) end
    end
    if now>=entry.clothesAt then
        entry.clothesAt=now+0.5
        local ancestor=part.Parent
        while ancestor and ancestor~=workspace and not ancestor:IsA("Camera") do
            for _,child in ipairs(ancestor:GetChildren()) do
                if child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") then
                    entry.detached[child]=true set(child,"Parent",nil)
                end
            end
            ancestor=ancestor.Parent
        end
    end

    if texture~="" and not part:IsA("MeshPart") and not special then
        if #entry.fields==0 then
            for _,face in ipairs(Enum.NormalId:GetEnumItems()) do
                local field=entry.scope:own(Instance.new("Texture"))
                field.Name,field.Texture,field.Face="DuckeyNebula",texture,face
                field:SetAttribute("DuckeyOwned",true) field:SetAttribute("DuckeyPaint",true)
                field.Parent=part table.insert(entry.fields,field)
            end
        end
        for _,field in ipairs(entry.fields) do
            field.Color3,field.Transparency=color,1-cfg.opacity
            field.StudsPerTileU,field.StudsPerTileV=cfg.textureScale or 3,cfg.textureScale or 3
            field.OffsetStudsU,field.OffsetStudsV=now*cfg.animationSpeed*0.08,now*cfg.animationSpeed*0.04
        end
    else
        for _,field in ipairs(entry.fields) do field.Transparency=1 end
    end
end
function Paint:finish()
    for part,entry in pairs(self.entries) do
        if not self.seen[part] then entry.scope:destroy() self.entries[part]=nil end
    end
end
return Paint

end)()

local Fov = (function()


local Fov: any={}
local function near(a,b)
    if a==b then return true end
    if not a or not b then return false end
    local aa,bb={a:GetComponents()},{b:GetComponents()}
    for i=1,12 do if math.abs(aa[i]-bb[i])>0.00001 then return false end end
    return true
end
function Fov.frame(ctx: any,camera: any)
    local state=ctx.fovController
    return state and state.camera==camera and state.native or camera.CFrame
end
function Fov.effective(ctx: any,camera: any)
    local state=ctx.fovController
    return state and state.camera==camera and ctx.config.customfov.fov or camera.FieldOfView
end
function Fov.renderFrame(ctx: any,camera: any)
    local frame=Fov.frame(ctx,camera)
    local value=Fov.effective(ctx,camera)
    if value<=120 then return frame end
    local scale=math.tan(math.rad(60))/math.tan(math.rad(value/2))
    return frame*CFrame.new(0,0,0,scale,0,0,0,scale,0,0,0,1)
end


function Fov.project(ctx: any,camera: any,position)
    local value=Fov.effective(ctx,camera)
    if value<=120 then return camera:WorldToViewportPoint(position) end
    local point=Fov.frame(ctx,camera):PointToObjectSpace(position)
    local view=camera.ViewportSize
    local depth=-point.Z
    local denominator=math.abs(depth)>0.000001 and depth or 0.000001
    local focal=view.Y/(2*math.tan(math.rad(value/2)))
    local x,y=view.X/2+point.X*focal/denominator,view.Y/2-point.Y*focal/denominator
    return Vector3.new(x,y,depth),depth>0 and x>=0 and x<=view.X and y>=0 and y<=view.Y
