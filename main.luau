        if not frame then
            if not pending then
                pending=createFrame(parts)
                if build(pending) then frame=pending pending=nil end
            end
            if not frame then return end
        end
        local view,lens=frame.view,frame.lens
        view.ImageColor3,view.ImageTransparency=UI.color(cfg.color),1-cfg.opacity

        lens.CFrame=Fov.renderFrame(ctx,camera) lens.FieldOfView=math.min(Fov.effective(ctx,camera),120)
        for part,entry in pairs(frame.copies) do
            entry.copy.CFrame,entry.copy.Size=part.CFrame,part.Size
            for _,pair in ipairs(entry.dynamic) do
                if pair.bone then pair.copy.Transform=pair.source.Transform
                else
                    pair.copy.Scale,pair.copy.Offset=pair.source.Scale,pair.source.Offset
                    if pair.copy:IsA("SpecialMesh") then pair.copy.MeshId=pair.source.MeshId end
                end
            end
        end
        serial+=1 view.ZIndex=serial
        view.Parent=root
        frame.at=now table.insert(frames,frame)
        previous=current sampled=now
    end,2150)
    return true
end
return Trail

end)()

local Visuals = (function()
local Visuals = {}
Visuals.__index = Visuals
function Visuals.new(ctx) return setmetatable({ctx=ctx},Visuals) end
local function make(class,properties,parent)
    local object=Instance.new(class)
    for key,value in pairs(properties) do object[key]=value end
    object:SetAttribute("DuckeyOwned",true) object.Parent=parent
    return object
end
local function bodyParts(index)
    local parts={}
    for _,part in ipairs(index:read()) do
        if not Models.isHelper(part) and not part:GetAttribute("DuckeyOwned") then table.insert(parts,part) end
    end
    return parts
end
function Visuals:groups(kind)
    local ctx=self.ctx
    if kind~="esp" then return {{parts=ctx.adapter:parts(kind)}} end
    local result,cfg={},ctx.config.esp
    local camera=workspace.CurrentCamera
    for _,player in ipairs(ctx.players:GetPlayers()) do
        local character=player.Character
        local humanoid=character and character:FindFirstChildOfClass("Humanoid")
        local head=character and character:FindFirstChild("Head")
        if camera and player~=ctx.player and humanoid and humanoid.Health>0 and head and
            (head.Position-camera.CFrame.Position).Magnitude<=cfg.maxDistance and
            not (cfg.teamCheck and ctx.player.Team~=nil and player.Team==ctx.player.Team) then
            table.insert(result,{root=character,player=player,humanoid=humanoid,head=head,distance=(head.Position-camera.CFrame.Position).Magnitude})
        end
    end
    table.sort(result,function(a,b) return a.distance<b.distance end)
    while #result>cfg.maxPlayers do table.remove(result) end
    local seen={}
    for _,group in ipairs(result) do
        local entry=self.bodyCache[group.root]
        if not entry then
            entry={scope=Core.Scope.new()}
            entry.index=Models.observe(group.root,entry.scope)
            self.bodyCache[group.root]=entry
        end
        if entry.index.dirty or not entry.parts then entry.parts=bodyParts(entry.index) end
        group.parts=entry.parts seen[group.root]=true
    end
    for character,entry in pairs(self.bodyCache) do
        if not seen[character] then entry.scope:destroy() self.bodyCache[character]=nil end
    end
    return result
end
function Visuals:start(scope,id,provider,_localMaterial)
    local ctx=self.ctx
    local paint=Paint.new(ctx,scope,id=="esp" and 30 or id=="characterchams" and 35 or 40)
    local outlines={}
    local renderESP
    scope:add(function() for _,item in pairs(outlines) do item:Destroy() end end)
    if id=="esp" then
        self.bodyCache={}
        scope:add(function()
            for _,entry in pairs(self.bodyCache) do entry.scope:destroy() end
            self.bodyCache={}
        end)
        renderESP=Esp.start(ctx,scope)
    end
    local function sync()
        local now,cfg=os.clock(),ctx.config[id]
        local a,b=UI.color(cfg.color),UI.color(cfg.color2)
        local seen={}
        paint:begin()
        local groups=provider()
        if renderESP then renderESP(groups) end
        for _,group in ipairs(groups) do
            local low,high=math.huge,-math.huge
            local varied=cfg.style=="Gradient" or cfg.style=="Galaxy"
            if varied then
                for _,part in ipairs(group.parts) do low=math.min(low,part.Position.Y) high=math.max(high,part.Position.Y) end
            end
            for _,part in ipairs(group.parts) do
                local t=varied and math.clamp((part.Position.Y-low)/math.max(high-low,0.1),0,1) or 0
                local tint=a
                if cfg.style=="Gradient" then tint=a:Lerp(b,t)
                elseif cfg.style=="Galaxy" then tint=a:Lerp(b,0.5+0.5*math.sin(now*cfg.animationSpeed*0.6+t*2.1)) end

                pcall(function() paint:apply(part,tint,cfg,now) end)
                local target=group.root or part
                if cfg.throughWalls and not seen[target] then
                    seen[target]=true
                    local highlight=outlines[target]
                    if not highlight then
                        highlight=make("Highlight",{Adornee=target,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,OutlineTransparency=0.8},ctx.effects)
                        outlines[target]=highlight
                    end
                    highlight.FillColor,highlight.OutlineColor=tint,tint
                    highlight.FillTransparency=math.max(0.6,1-cfg.opacity*0.4)
                end
            end
        end
        paint:finish()
        for target,highlight in pairs(outlines) do if not seen[target] then highlight:Destroy() outlines[target]=nil end end
    end
    sync()
    scope:render(ctx.run,sync)
    return true
end
function Visuals:afterimage(scope) return Trail.start(self.ctx,scope) end
return Visuals

end)()

local AnimatedKnife = (function()

local AnimatedKnife={}
local function animations(root)
    local result={}
    for _,object in ipairs(root:GetDescendants()) do
        if object:IsA("Animation") and object.AnimationId~="" then result[object.Name:lower()]=object end
    end
    return result
end
function AnimatedKnife.start(ctx: any,scope: any,source: any)
    if not source:IsA("Model") or not source:FindFirstChild("HumanoidRootPart")
        or not source:FindFirstChildWhichIsA("Motor6D",true) or not animations(source).idle then
        return false,"Choose an animated Arsenal viewmodel template. Static models are not supported."
    end
    local active,live,css,owner=nil,nil,nil,{}
    local function clear()

        ctx.layers:remove(owner)
        if active then active:destroy() active=nil end
        ctx.adapter.overrides.weapon,ctx.adapter.overrides.hands=nil,nil
        ctx.knifeSource=nil
        ctx.knifeModel=nil
        ctx.placeKnife=nil
        live,css=nil,nil
    end
    scope:add(clear)
    local function attach(original)
        clear()
        local originalRoot=original:FindFirstChild("HumanoidRootPart")
        local originalAnimator=original:FindFirstChildWhichIsA("Animator",true)
        if not originalRoot or not originalAnimator then return false,"The live knife animation rig is not ready." end
        live,css,active=original,original:FindFirstChild("CSSArms"),Core.Scope.new()
        ctx.knifeSource=original
        local was=source.Archivable source.Archivable=true
        local ok,clone=pcall(function() return source:Clone() end) source.Archivable=was
        if not ok or not clone then clear() return false,"Knife template could not be cloned." end
        active:own(clone)
        clone.Name="DuckeyAnimatedKnife" clone:SetAttribute("DuckeyOwned",true)
        for _,object in ipairs(clone:GetDescendants()) do
            if object:IsA("LuaSourceContainer") or object:IsA("Animator") or object:IsA("Sound") then object:Destroy() end
        end
        local root=clone:FindFirstChild("HumanoidRootPart")
        local controller=clone:FindFirstChildOfClass("AnimationController")
        if not controller then controller=Instance.new("AnimationController") controller.Parent=clone end
        local animator=Instance.new("Animator") animator.Parent=controller
        local weapon,hands={},{}
        for _,part in ipairs(Models.allParts(clone)) do
            part.Anchored=part==root
            part.CanCollide,part.CanTouch,part.CanQuery,part.Massless=false,false,false,true
            part:SetAttribute("DuckeyOwned",true)
            if not Models.isHelper(part) then
                table.insert(Models.kind(part,clone.Parent,"")=="hands" and hands or weapon,part)
            end
        end


        clone.PrimaryPart=root
        local appliedScale=nil
        local function syncScale()
            local scale=original:GetScale()
            assert(type(scale)=="number" and scale==scale and scale>0 and scale<math.huge,"Invalid live viewmodel scale")
            if appliedScale~=scale then
                clone:ScaleTo(scale)
                appliedScale=scale
            end
        end
        syncScale()
        root.CFrame=originalRoot.CFrame
        clone.Parent=ctx.effects
        ctx.knifeModel=clone
        local selected=animations(clone)
        local nativeSlots={}
        for name,animation in pairs(animations(original)) do nativeSlots[animation.AnimationId]=name end
        local mirrors,ownedTracks,loaded={},{},{}
        local function load(animation)
            if loaded[animation] then return loaded[animation] end
            local track=animator:LoadAnimation(animation)
            loaded[animation]=track
            table.insert(ownedTracks,track)
            return track
        end
        active:add(function() for _,track in ipairs(ownedTracks) do pcall(function() track:Stop(0.05) track:Destroy() end) end end)
        local idle=load(selected.idle) idle.Looped=true idle.Priority=Enum.AnimationPriority.Idle idle:Play(0.08)
        local inspectTrack=nil
        local function stopInspect()
            if inspectTrack then inspectTrack:Stop(0.05) inspectTrack=nil end
        end
        local function mirror(track,played)
            if mirrors[track] and not played then return mirrors[track] end
            local animation=track.Animation
            if not animation then return nil end
            local name=animation.Name:lower()
            if not selected[name] then name=nativeSlots[animation.AnimationId] or name end
            if name=="idle" then return nil end
            local inspecting=name=="inspect" or name=="rinspect" or name:match("^inspect%d+$")~=nil


            stopInspect()
            local entry={inspect=inspecting}
            mirrors[track]=entry
            local replacement=selected[name] or (inspecting and selected.inspect) or (name:match("^fire%d*$") and selected.fire)
            if not replacement then return entry end
            local copy=load(replacement)
            entry.copy=copy
            copy.Priority=track.Priority
            if inspecting then
                copy.Looped=false
                copy:Play(0.04,1,1)
                copy.TimePosition=0
                inspectTrack=copy
            else
                copy.Looped=track.Looped
                copy:Play(0.04,math.max(track.WeightCurrent,0.01),track.Speed)
            end
