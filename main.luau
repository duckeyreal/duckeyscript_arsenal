local function watchHumanoid(scope, callback)
    local current
    local function attach(character)
        if current then current:destroy() end
        current = Core.Scope.new()
        local seen
        local function check()
            local h = character:FindFirstChildOfClass("Humanoid")
            if h and h ~= seen then seen = h callback(h, current) end
        end
        current:connect(character.ChildAdded, check)
        check()
    end
    scope:add(function() if current then current:destroy() end end)
    scope:connect(Player.CharacterAdded, attach)
    scope:connect(Player.CharacterRemoving, function() if current then current:destroy() current = nil end end)
    if Player.Character then attach(Player.Character) end
end
