                donor = source:FindFirstChild(part.Name, true) or source:FindFirstChildWhichIsA("MeshPart", true) or source:FindFirstChildWhichIsA("Texture", true)
                or source:FindFirstChildWhichIsA("StringValue",true) or source:FindFirstChildWhichIsA("SurfaceAppearance",true)
