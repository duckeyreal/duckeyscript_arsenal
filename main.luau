    if not shot and self.knifePlan and os.clock()<=self.knifeUntil and self.host.isKnife() then shot=self.knifePlan end
    if not shot and self.movement and self.movement.kind=="projectile" and not self.movement.done then shot=self.movement.context end
    if not shot or shot.reading or object~=shot.camera or not self:valid(shot.chosen) then return end
