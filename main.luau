local Reload={}
local function nameOf(fn,api)
    if type(api.info)=="function" then local ok,name=pcall(api.info,fn,"n") if ok then return name end end
    if type(api.getinfo)=="function" then local ok,info=pcall(api.getinfo,fn) if ok then return info.name end end
