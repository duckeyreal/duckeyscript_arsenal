function Combat:shot(name,original,...)
    if not self:enabled() then return original(...) end
    local thread=coroutine.running()
    local active=self.dispatches[thread]
    if active and active[name] then return original(...) end
    if not active then active={} self.dispatches[thread]=active end
    active[name]=true
    local result=table.pack(pcall(self.runShot,self,name,original,...))
    active[name]=nil
    if not next(active) then self.dispatches[thread]=nil end
    if not result[1] then error(result[2],0) end
    return table.unpack(result,2,result.n)
end
function Combat:cast(original,method,object,...)
    local h=self.host
    if self.dead or not self.modes.infkniferange or not casts[method] or object~=workspace
        or self.movement or os.clock()>self.knifeUntil or h.checkcaller() or h.blocked() or not h.isKnife() then return false end
    local thread=coroutine.running()
    if self.castBusy[thread] then return false end
    if not self:castCaller() then return false end
    local args=table.pack(...)
    local origin,direction
    if method=="Raycast" then origin,direction=args[1],args[2]
    elseif typeof(args[1])=="Ray" then origin,direction=args[1].Origin,args[1].Direction end
    if not finite(origin) or not finite(direction) or direction.Magnitude<1 or direction.Magnitude>16 then return false end
    local chosen=self.knifePlan and self.knifePlan.chosen or h.target()
    if not self:valid(chosen) then return false end
    local root=h.player.Character:FindFirstChild("HumanoidRootPart")
    local camera=workspace.CurrentCamera
    local _,planned=self:geometry(chosen,"knife")
    if (origin-root.Position).Magnitude>12 and (not camera or (origin-camera.CFrame.Position).Magnitude>12)
        and (not self.knifePlan or not planned or (origin-planned).Magnitude>12) then return false end


    local move=self:move(chosen,"knife")
    if not move then return false end


    if camera then
