function UI:Setting(parent: any, module: any, spec: any, scope: any, refreshers: any, order: number)
    local row = make("Frame", { Name = module.id .. "." .. spec.key, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, spec.type == "slider" and 54 or 36), LayoutOrder = order }, parent)
