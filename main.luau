        local on = self.ctx.enabled(id)
        row.state.Text = on and "ON" or "OFF"
        row.state.TextColor3 = on and C.green or C.red
        row.state.BackgroundColor3 = on and C.green or C.red
        row.state.BackgroundTransparency = on and 0.88 or 0.94
        row.stroke.Color, row.stroke.Transparency = on and C.yellow or C.line, on and 0.4 or 0.65
