            label(header, module.name, 15, C.text, { Position = UDim2.fromOffset(16, 11), Size = UDim2.new(1, -218, 0, 23) })
            label(header, module.description, 11, C.muted, { Position = UDim2.fromOffset(16, 36), Size = UDim2.new(1, -90, 0, 21) })
            local reset = button(header, "Reset", { Name="ResetConfig", Position=UDim2.new(1,-155,0,12),
                Size=UDim2.fromOffset(48,24), TextSize=10, TextColor3=C.muted, BackgroundTransparency=0.25 })
            self.pageScope:connect(reset.Activated,function() self.ctx.reset(module.id) self:Refresh() end)
            local state = label(header, "OFF", 10, C.red, { Position = UDim2.new(1, -98, 0, 12), Size = UDim2.fromOffset(40, 22), TextXAlignment = Enum.TextXAlignment.Center })
            corner(state, 5)
            local expand = button(header, "", { Name = "Configure", Position = UDim2.new(1, -41, 0, 15), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 0.25 })
            expand.Visible=#module.settings>0
            local chevron=icon(expand,"chevron",16,C.muted) chevron.Position=UDim2.fromOffset(5,5)
            local config = make("Frame", { Name = "Config", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1, Visible = false, LayoutOrder = 2 }, card)
            padding(config, 16)
            make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, config)
            local refreshers = {}
            self.rows[module.id] = { state = state, stroke = border, refreshers = refreshers, config = config, card = card }
            for i, spec in ipairs(module.settings) do self:Setting(config, module, spec, self.pageScope, refreshers, i) end
            local function reveal() if #module.settings==0 then return end config.Visible = not config.Visible chevron.Rotation = config.Visible and 180 or 0 end
            self.pageScope:connect(header.Activated, function() self.ctx.toggle(module.id) self:Refresh() end)
            self.pageScope:connect(header.MouseButton2Click, reveal)
            self.pageScope:connect(expand.Activated, reveal)
        end
    end
    self:Refresh()
end
function UI:Destroy()
    if self.pageScope then self.pageScope:destroy() end
    self.scope:destroy()
end
