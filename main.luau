        local value = source.Value
        return tonumber(value) and ("rbxassetid://" .. value) or value
    end
    if source:IsA("Decal") or source:IsA("Texture") then return source.Texture end
    if source:IsA("MeshPart") then return source.TextureID end
    if source:IsA("SpecialMesh") then return source.TextureId end
