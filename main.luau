function Models.new(ctx: any)
    local self=setmetatable({ctx=ctx},Models)
    ctx.scope:add(function() if self.watch then self.watch:destroy() end if self.bodyWatch then self.bodyWatch:destroy() end end)
    return self
end
function Models:view(weaponName)
    local camera,character=workspace.CurrentCamera,self.ctx.player.Character
    if self.camera~=camera or self.character~=character or self.weaponName~=weaponName or not self.watch then
        if self.watch then self.watch:destroy() end
        self.watch=Core.Scope.new()
        self.watch:add(function() if self.assemblyWatch then self.assemblyWatch:destroy() self.assemblyWatch=nil end end)
        self.camera,self.character,self.weaponName=camera,character,weaponName
        self.dirty=true
        local function invalidate(object)
            if structural(object) and not ignored(object,camera) then self.dirty=true end
        end
        if camera then
            self.watch:connect(camera.DescendantAdded,invalidate)
            self.watch:connect(camera.DescendantRemoving,invalidate)
        end
        if character then
            self.watch:connect(character.DescendantAdded,invalidate)
            self.watch:connect(character.DescendantRemoving,invalidate)
        end
        local function rootChanged(object)
            if roots[norm(object.Name)] or object.Name=="HWRAP_"..self.ctx.player.Name then self.dirty=true end
        end
        self.watch:connect(workspace.ChildAdded,rootChanged)
        self.watch:connect(workspace.ChildRemoved,rootChanged)
    end
    if self.cached and not self.dirty then return self.cached end
    if self.assemblyWatch then self.assemblyWatch:destroy() end
    self.assemblyWatch=Core.Scope.new()
    local watcher=self.assemblyWatch
    local result, seen, assemblies = {hands={},weapon={}}, {}, {}
    if camera then
        for _,branch in ipairs(camera:GetChildren()) do
            if not ignored(branch,camera) then
                local name=norm(branch.Name)
                local renderAssembly=roots[name] or name=="gun" or name=="weapon" or name==norm(weaponName or "") or branch:IsA("Tool")
                if not renderAssembly then
                    for _,part in ipairs(allParts(branch)) do
                        if namedKind(part,camera,norm(weaponName or "")) and not ignored(part,camera) then renderAssembly=true break end
                    end
                end
                if renderAssembly then table.insert(assemblies,branch) end
            end
        end
    end
    for _,object in ipairs(workspace:GetChildren()) do
        if object~=camera and roots[norm(object.Name)] and not object:GetAttribute("DuckeyOwned") then table.insert(assemblies,object) end
    end
    for _,root in ipairs(assemblies) do
        if root.Parent==workspace then
            local function invalidate(object) if structural(object) and not ignored(object,root) then self.dirty=true end end
            watcher:connect(root.DescendantAdded,invalidate)
            watcher:connect(root.DescendantRemoving,invalidate)
        end
        local kinds, parts = {}, {}
        local descendants=root:GetDescendants()
        local function reclassify() self.dirty=true end
        watcher:connect(root:GetPropertyChangedSignal("Name"),reclassify)
        for _,item in ipairs(descendants) do
            if item:IsA("BasePart") or item:IsA("Weld") or item:IsA("WeldConstraint") then
                watcher:connect(item:GetPropertyChangedSignal("Name"),reclassify)
            end
            if item:IsA("Weld") or item:IsA("WeldConstraint") then
                watcher:connect(item:GetPropertyChangedSignal("Part0"),reclassify)
                watcher:connect(item:GetPropertyChangedSignal("Part1"),reclassify)
            end
        end
        local partCandidates=descendants
        if root:IsA("BasePart") then partCandidates=table.clone(descendants) table.insert(partCandidates,root) end
        for _,part in ipairs(partCandidates) do
            if part:IsA("BasePart") and not seen[part] and not ignored(part,camera) and not helpers[norm(part.Name)] then
                seen[part]=true table.insert(parts,part)
                kinds[part]=namedKind(part,root.Parent,norm(weaponName or ""))
            end
        end

        for _=1,2 do
            for _,joint in ipairs(descendants) do
                if joint:IsA("Weld") or joint:IsA("WeldConstraint") then
                    local name=norm(joint.Name)
                    if not name:find("grip",1,true) and not name:find("gun",1,true) and not name:find("weapon",1,true) then
                        local a,b=joint.Part0,joint.Part1
                        if a and b and seen[a] and seen[b] and not helpers[norm(a.Name)] and not helpers[norm(b.Name)] then
                            if kinds[a]=="hands" and not kinds[b] then kinds[b]="hands" end
                            if kinds[b]=="hands" and not kinds[a] then kinds[a]="hands" end
                        end
                    end
                end
            end
        end
        for _,part in ipairs(parts) do table.insert(result[kinds[part] or "weapon"],part) end
    end
    local character=self.ctx.player.Character
    if #result.weapon==0 and character then
        local wrapper=workspace:FindFirstChild("HWRAP_"..self.ctx.player.Name)
        local gun=character:FindFirstChild("Gun") or character:FindFirstChildOfClass("Tool") or (wrapper and wrapper:FindFirstChild("Gun"))
        if wrapper then
            watcher:connect(wrapper.DescendantAdded,function() self.dirty=true end)
            watcher:connect(wrapper.DescendantRemoving,function() self.dirty=true end)
        end
        for _,part in ipairs(allParts(gun)) do if not helpers[norm(part.Name)] then table.insert(result.weapon,part) end end
    end
    self.cached=result
    self.dirty=false
    return result
end
function Models:parts(kind, overrides, weaponName)
    if overrides[kind] then
        local result={}
        for _,part in ipairs(overrides[kind]) do if part.Parent then table.insert(result,part) end end
        return result
    end
    if kind~="character" then return self:view(weaponName)[kind] or {} end
    local character=self.ctx.player.Character
    if character~=self.bodyRoot then
        if self.bodyWatch then self.bodyWatch:destroy() end
        self.bodyRoot,self.bodyWatch=character,Core.Scope.new()
        self.bodyIndex=character and Models.observe(character,self.bodyWatch)
    end
    local result={}
    for _,part in ipairs(self.bodyIndex and self.bodyIndex:read() or {}) do
        if not helpers[norm(part.Name)] and not part:GetAttribute("DuckeyOwned") then table.insert(result,part) end
    end
    return result
end
return Models

end)()

local Catalog = (function()

local Catalog = {}
Catalog.__index = Catalog
local function norm(s) return s:lower():gsub("[^%w]","") end
local function model(object) return object:IsA("Model") or object:IsA("Folder") or object:IsA("Tool") end
local function character(object)
    if not model(object) then return false end
    local head=object:FindFirstChild("Head")
    local torso=object:FindFirstChild("Torso") or object:FindFirstChild("UpperTorso")
    return head and head:IsA("BasePart") and torso and torso:IsA("BasePart")
end
local function hasParts(object) return object:IsA("BasePart") or object:FindFirstChildWhichIsA("BasePart",true)~=nil end
local function animatedKnife(object)
    if not object:IsA("Model") then return false end
    local root=object:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") or not object:FindFirstChildWhichIsA("Motor6D",true) then return false end
    for _,child in ipairs(object:GetDescendants()) do
        if child:IsA("Animation") and child.Name:lower()=="idle" and child.AnimationId~="" and child.AnimationId~="rbxassetid://0" then return true end
    end
    return false
end
local knifeRoots={knives=true,melee=true,melees=true,knifeskins=true,meleeskins=true,knifemodels=true,meleemodels=true}
local finishRoots={skins=true,weaponskins=true,gunskins=true,weaponfinishes=true,weapontextures=true,guntextures=true,camos=true,wraps=true,patterns=true}
local knifeWords={"knife","dagger","karambit","bayonet","katana","sword","cutlass","saber","machete","butterfly","kunai"}
local function texture(value)
    if type(value)~="string" then return false end
    return value:match("^%d+$")~=nil or value:match("^rbxassetid://%d+")~=nil or value:match("^https?://.*[?&]id=%d+")~=nil
end
function Catalog.new(ctx: any)
    return setmetatable({ctx=ctx,lists={knife={},weaponskin={},characterskin={}},assets={},ids=setmetatable({},{__mode="k"}),serial=0,scanned=false},Catalog)
end
function Catalog:isMelee(name)
    name=name:gsub("^v_","")
    local melees=self.ctx.storage:FindFirstChild("Melees")
    if melees and melees:FindFirstChild(name) then return true end
    local key=norm(name)
    for _,word in ipairs(knifeWords) do if key:find(word,1,true) then return true end end
    local weapons=self.ctx.storage:FindFirstChild("Weapons")
    local entry=weapons and weapons:FindFirstChild(name)
    if entry then
        for _,flag in ipairs({"Melee","IsKnife","IsMelee"}) do
            local value=entry:FindFirstChild(flag)
            if value and (not value:IsA("BoolValue") or value.Value) then return true end
        end
    end
    return false
end
function Catalog:scan()
    local objects,seen={},{}
    local function addTree(root)
        if not root or seen[root] or root:GetAttribute("DuckeyOwned") then return end
        seen[root]=true table.insert(objects,root)

        for _,child in ipairs(root:GetChildren()) do addTree(child) end
    end
    addTree(self.ctx.storage)

    addTree(self.ctx.lighting)
    if type(self.ctx.getnilinstances)=="function" then
        local ok,detached=pcall(self.ctx.getnilinstances)
        if ok and type(detached)=="table" then
            for _,object in ipairs(detached) do
                local valid,isModel=pcall(function() return model(object) or object:IsA("BasePart") end)
                if valid and isModel then addTree(object) end
            end
        end
    end
    self.lists,self.assets={knife={},weaponskin={},characterskin={}},{ }
    local chars={}
    for _,object in ipairs(objects) do if character(object) then chars[object]=true end end
    local function add(kind,object,label)
        if not self.ids[object] then self.serial+=1 self.ids[object]="loaded:"..self.serial end
        local id=kind..":"..self.ids[object]
        if self.assets[id] then return end
        self.assets[id]=object
        table.insert(self.lists[kind],{id=id,name=label or object.Name})
    end
    local excludedCharacters={taunts=true,killeffects=true,other=true,uistorage=true,itemunusuals=true}
    local streamed=self.ctx.storage:FindFirstChild("StreamedAssets")
    local chrModels=streamed and streamed:FindFirstChild("ChrModels")
    local legacyChrModels=self.ctx.storage:FindFirstChild("ChrModels")
    local function usableCharacter(object)
        local current,known=object,not chrModels or object.Parent==nil
        while current do
            if current==chrModels or current==legacyChrModels then known=true end
            local name=norm(current.Name)
            if excludedCharacters[name] or name:find("ragdoll",1,true) then return false end
            current=current.Parent
        end
        return known
    end
    local knives={}
    local canonical=self.ctx.storage:FindFirstChild("Viewmodels")
    local function considerKnife(object,label)
        if not animatedKnife(object) then return end
        label=label:gsub("^[vV]_","")
        local key=label:lower()
        local rank=canonical and object.Parent==canonical and 1 or object:IsDescendantOf(self.ctx.storage) and 2 or object.Parent and 3 or 4
        local old=knives[key]
        if not old or rank<old.rank or (rank==old.rank and object:GetFullName()<old.object:GetFullName()) then
            knives[key]={object=object,label=label,rank=rank}
        end
    end
    for _,object in ipairs(objects) do
        if chars[object] then if usableCharacter(object) then add("characterskin",object) end
        else
            local parent=object.Parent
            local parentName=parent and norm(parent.Name) or ""
            local displayName=object.Name:gsub("^[vV]_","")
            if (model(object) or object:IsA("BasePart")) and hasParts(object)
                and (knifeRoots[parentName] or self:isMelee(displayName)) then considerKnife(object,displayName) end
            local current,inFinish,inCharacter,inDefinition=parent,false,false,false
            while current do
                if chars[current] then inCharacter=true break end
                if current:IsA("StringValue") and texture(current.Value) then inDefinition=true end
                if finishRoots[norm(current.Name)] then inFinish=true end
                current=current.Parent
            end
            if inFinish and not inCharacter and not inDefinition and not norm(object.Name):find("thumbnail",1,true) and not norm(object.Name):find("icon",1,true) then
                local supported=object:IsA("Texture") or object:IsA("Decal") or object:IsA("SurfaceAppearance") or object:IsA("Color3Value")
                    or (object:IsA("StringValue") and texture(object.Value))
                    or (model(object) and hasParts(object)) or (object:IsA("MeshPart") and texture(object.TextureID))
                if supported then
                    local name=object.Name
                    if parent and (name=="Texture" or name=="TextureId" or name=="TextureID" or name=="Color" or name=="SurfaceAppearance") then name=parent.Name end
                    add("weaponskin",object,name)
                end
            end
        end
    end
    for _,entry in pairs(knives) do add("knife",entry.object,entry.label) end
    for _,list in pairs(self.lists) do table.sort(list,function(a,b) return a.name:lower()<b.name:lower() end) end
    self.scanned=true
    self.lastScan={objects=#objects,knife=#self.lists.knife,weaponskin=#self.lists.weaponskin,characterskin=#self.lists.characterskin}
end
function Catalog:list(kind,refresh)
    if refresh or not self.scanned then self:scan() end
    return self.lists[kind] or {}
end
function Catalog:asset(kind,id)
    if not self.scanned then self:scan() end
    local object=self.assets[id]
    if object and id:sub(1,#kind+1)==kind..":" then return object end
    return nil
end
return Catalog

end)()

local Adapter = (function()
local Adapter = {}
Adapter.__index = Adapter
local function lower(name) return name:lower():gsub("[%s_%-%.]", "") end
local function descendants(root)
    if not root then return {} end
    return root:GetDescendants()
end
function Adapter.new(ctx)
    return setmetatable({ ctx = ctx, resolver = Models.new(ctx), catalogSource = Catalog.new(ctx), overrides = {} }, Adapter)
end
function Adapter:resolve(path)
    local root = game
    for name in path:gmatch("[^%./]+") do
        if name ~= "game" then
            local child = root:FindFirstChild(name)
            if not child then return nil end
            root = child
        end
    end
    return root ~= game and root or nil
end
function Adapter:parts(kind)
    return self.resolver:parts(kind, self.overrides, self:weaponName())
end
function Adapter:weaponName()
    local character = self.ctx.player.Character
    if not character then return nil end
    local equipped=character:FindFirstChild("EquippedWep")
    if equipped and equipped:IsA("StringValue") and equipped.Value~="" then return equipped.Value end
    local gun = character:FindFirstChild("Gun") or character:FindFirstChildOfClass("Tool")
    local wrapper=workspace:FindFirstChild("HWRAP_"..self.ctx.player.Name)
    gun=gun or (wrapper and wrapper:FindFirstChild("Gun"))
    if gun then
        local value = gun:FindFirstChild("Boop") or gun:FindFirstChild("WeaponName")
        if value and value:IsA("StringValue") then return value.Value end
        if gun:IsA("Tool") then return gun.Name end
    end
    local camera=workspace.CurrentCamera
    local arms=camera and camera:FindFirstChild("Arms")
    local real=arms and arms:FindFirstChild("Real")
    if real and real:IsA("StringValue") and real.Value~="" then return real.Value:gsub("^v_","") end
    local value = self.ctx.player:FindFirstChild("CurrentWeapon")
    return value and value:IsA("StringValue") and value.Value or nil
end
function Adapter:isKnife()
    local name = self:weaponName()
    return name ~= nil and self.catalogSource:isMelee(name)
end
function Adapter:isProjectile()
    local name=self:weaponName()
    if not name or self:isKnife() then return false end
    local weapons=self.ctx.storage:FindFirstChild("Weapons")
    local weapon=weapons and weapons:FindFirstChild(name)
    if weapon then
        for _,key in ipairs({"Projectile","Electricity"}) do
            local marker=weapon:FindFirstChild(key)
            if marker and (not marker:IsA("BoolValue") or marker.Value) then return true end
        end
    end
    local projectiles=self.ctx.storage:FindFirstChild("Projectiles")
    return projectiles~=nil and projectiles:FindFirstChild(name)~=nil
end
function Adapter:catalog(kind, refresh) return self.catalogSource:list(kind, refresh) end
function Adapter:asset(kind, id) return self.catalogSource:asset(kind, id) end
function Adapter:ammo(path)
    local function read(object)
        if not object then return nil end
        if object:IsA("IntValue") or object:IsA("NumberValue") then return math.max(0, object.Value) end
        if object:IsA("TextLabel") or object:IsA("TextBox") then return tonumber(object.Text:match("^%s*(%d+)%s*[/|]?")) end
        return nil
    end
    if path ~= "" then return read(self:resolve(path)) end
    local roots = { self.ctx.player.Character, self.ctx.player:FindFirstChild("NRPBS"), self.ctx.player:FindFirstChild("PlayerGui") }
    for _, root in pairs(roots) do
        for _, item in ipairs(descendants(root)) do
            local n = lower(item.Name)
            if n == "ammo" or n == "ammocount" or n == "currentammo" or n == "clip" or n == "magazine" then
                local amount = read(item)
                if amount then return amount end
            end
        end
    end
    return nil
end
function Adapter.cleanClone(source, includeChildren)
    local old = source.Archivable
    source.Archivable = true
    local ok, clone = pcall(function() return source:Clone() end)
    source.Archivable = old
    if not ok or not clone then return nil end
    for _, item in ipairs(clone:GetDescendants()) do
        if item:IsA("LuaSourceContainer") or item:IsA("JointInstance") or item:IsA("Constraint") or item:IsA("Humanoid") or item:IsA("Animator") or item:IsA("AnimationController")
            or (source:IsA("BasePart") and not includeChildren and item:IsA("BasePart")) then item:Destroy() end
    end
    clone:SetAttribute("DuckeyOwned", true)
    local parts = clone:GetDescendants()
    if clone:IsA("BasePart") then table.insert(parts,clone) end
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            part:SetAttribute("DuckeyOwned", true)
            part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
        end
    end
    return clone
end
return Adapter

end)()

local UI = (function()
