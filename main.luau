local Core = (function()

local Core = {}
Core.ownedCallbacks = setmetatable({}, {__mode="k"})


function Core.allowMeshClone(ctx)
    local budget=ctx.meshBudget
    if not budget or budget.frame~=ctx.meshFrame then
        budget={frame=ctx.meshFrame,started=os.clock(),count=0} ctx.meshBudget=budget
    end
    if budget.count>=12 or (budget.count>0 and os.clock()-budget.started>=0.001) then return false end
    budget.count+=1 return true
end

local Scope = {}
Scope.__index = Scope

function Scope.new()
    return setmetatable({ alive = true, connections = {}, cleanups = {}, properties = {}, propertyOrder = {} }, Scope)
end

function Scope:add(cleanup)
    if not self.alive then
        pcall(cleanup)
    else
        table.insert(self.cleanups, cleanup)
    end
    return cleanup
end

function Scope:connect(signal, callback)
    if not self.alive then return nil end
    local callbackWrapper = function(...)
        if self.alive then callback(...) end
    end
    Core.ownedCallbacks[callbackWrapper] = true
    local connection = signal:Connect(callbackWrapper)
    table.insert(self.connections, connection)
    return connection
end

function Scope:own(object, method)
    self:add(function() object[method or "Destroy"](object) end)
    return object
end


local renderSerial = 0
function Scope:render(run, callback, priority)
    if type(run.BindToRenderStep) == "function" and type(run.UnbindFromRenderStep) == "function" then
        renderSerial += 1
        local name = "DuckeyRender_" .. tostring(renderSerial) .. "_" .. tostring(os.clock())
        run:BindToRenderStep(name, priority or 2100, function(dt) if self.alive then callback(dt) end end)
        self:add(function() run:UnbindFromRenderStep(name) end)
    else
        self:connect(run.RenderStepped, callback)
    end
end

function Scope:set(object, property, value)
    if not self.alive then return false end
    local ok, current = pcall(function() return object[property] end)
    if not ok then return false end
    local objectProperties = self.properties[object]
    if not objectProperties then
        objectProperties = {}
        self.properties[object] = objectProperties
    end
    local record = objectProperties[property]
    if not record then
        record = { object = object, property = property, original = current, written = current }
        objectProperties[property] = record
        table.insert(self.propertyOrder, record)
    end
    if current == value then
        record.written = value
        return true
    end
    local written = pcall(function() object[property] = value end)
    if written then record.written = value end
    return written
end

function Scope:destroy()
    if not self.alive then return end
    self.alive = false
    for _, connection in ipairs(self.connections) do pcall(function() connection:Disconnect() end) end
    table.clear(self.connections)

    for i = #self.propertyOrder, 1, -1 do
        local record = self.propertyOrder[i]
        pcall(function()
            if record.object[record.property] == record.written then
                record.object[record.property] = record.original
            end
        end)
    end
    table.clear(self.propertyOrder)
    table.clear(self.properties)
    for i = #self.cleanups, 1, -1 do pcall(self.cleanups[i]) end
    table.clear(self.cleanups)
end

Core.Scope = Scope

local Manager = {}
Manager.__index = Manager

function Manager.new(onChange, onError)
    return setmetatable({ alive = true, modules = {}, order = {}, onChange = onChange, onError = onError }, Manager)
end

function Manager:register(name, start)
    assert(not self.modules[name], "Duplicate module " .. name)
    self.modules[name] = { enabled = false, start = start }
    table.insert(self.order, name)
end

function Manager:isEnabled(name)
    local module = self.modules[name]
    return self.alive and module ~= nil and module.enabled
end

function Manager:set(name, enabled)
    local module = self.modules[name]
    if not self.alive or not module then return false, "Menu is closed" end
    if module.enabled == enabled then return true end
    if enabled then
        local scope = Scope.new()
        local ok, accepted, reason = pcall(module.start, scope)
        if not ok or accepted == false then
            scope:destroy()
            local message = ok and (reason or "Unavailable") or tostring(accepted)
            if self.onChange then self.onChange(name, false, message) end
            if self.onError then self.onError(name, message) end
            return false, message
        end
        if not self.alive then
            scope:destroy()
            return false, "Menu is closed"
        end
        module.scope = scope
        module.enabled = true
    else
        module.enabled = false
        local scope = module.scope
        module.scope = nil
        if scope then scope:destroy() end
    end
    if self.onChange then self.onChange(name, module.enabled) end
    return true
end

function Manager:toggle(name)
    return self:set(name, not self:isEnabled(name))
end

function Manager:destroy()
    if not self.alive then return end
    for i = #self.order, 1, -1 do self:set(self.order[i], false) end
    self.alive = false
end

Core.Manager = Manager


function Core.closest(candidates, cursor, radius, localTeam, teamCheck)
    local closest, distance = nil, radius
    for _, candidate in ipairs(candidates) do
        local teammate = localTeam ~= nil and candidate.team ~= nil and candidate.team == localTeam
        if candidate.alive and candidate.onScreen and candidate.depth > 0 and not (teamCheck and teammate) then
            local offset = (candidate.screen - cursor).Magnitude
            if offset < distance then closest, distance = candidate, offset end
        end
    end
    return closest
end


function Core.redirect(origin, direction, targetPosition)
    local length = direction.Magnitude
    local offset = targetPosition - origin
    if length < 0.001 or offset.Magnitude < 0.001 or offset.Magnitude > length then return nil end
    return offset.Unit * length
end

function Core.buttonState(enabled, onColor, offColor)
    return enabled and "ON" or "OFF", enabled and onColor or offColor
end

return Core

end)()

local Layers = (function()

local Layers = {}
Layers.__index = Layers
function Layers.new() return setmetatable({ records = {}, owners = {} }, Layers) end
local function read(object,property) return object[property] end
local function write(object,property,value) object[property]=value end
function Layers:apply(record)
    local ok, current = pcall(read,record.object,record.property)
    if not ok then return false end
    if current ~= record.last then record.base = current end
    if record.selectDirty then
        local selected
        for _, entry in pairs(record.values) do if not selected or entry.priority > selected.priority then selected = entry end end
        record.selected,record.selectDirty=selected,false
    end
    local selected=record.selected
    local value = record.base
    if selected then value = selected.value end
    if current == value then record.last = value return true end
    local written = pcall(write,record.object,record.property,value)
    if written then record.last = value end
    return written
end
function Layers:set(owner, object, property, value, priority)
    local properties = self.records[object]
    if not properties then properties = {} self.records[object] = properties end
    local record = properties[property]
    if not record then
        local ok, original = pcall(function() return object[property] end)
        if not ok then return false end
        record = { object = object, property = property, base = original, last = original, values = {} }
        properties[property] = record
    end
    self.owners[owner] = self.owners[owner] or {}
    self.owners[owner][record] = true
    local entry = record.values[owner]
    if not entry or entry.priority~=(priority or 10) then record.selectDirty=true end
    if entry then entry.value,entry.priority = value,priority or 10
    else record.values[owner] = { value = value, priority = priority or 10 } end
    return self:apply(record)
end
function Layers:remove(owner)
    local records = self.owners[owner]
    if not records then return end
    for record in pairs(records) do
        record.values[owner] = nil
        record.selectDirty=true
        self:apply(record)
        if next(record.values) == nil then
            local properties = self.records[record.object]
            properties[record.property] = nil
            if next(properties) == nil then self.records[record.object] = nil end
        end
    end
    self.owners[owner] = nil
end
function Layers:forget(owner, object)
    local records = self.owners[owner]
    if not records then return end
    for record in pairs(records) do
        if record.object == object then
            record.values[owner], records[record] = nil, nil
            record.selectDirty=true
            self:apply(record)
            if next(record.values) == nil then
                local properties = self.records[object]
                properties[record.property] = nil
                if next(properties) == nil then self.records[object] = nil end
            end
        end
    end
end
function Layers:Destroy()
    local owners = {}
    for owner in pairs(self.owners) do table.insert(owners, owner) end
    for _, owner in ipairs(owners) do self:remove(owner) end
end
return Layers

end)()

