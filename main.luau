function UI:Position(x, y)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local size = cam.ViewportSize
    self.window.Position = UDim2.fromOffset(math.clamp(x, 8, math.max(8, size.X - 820 * self.scale.Scale - 8)),
        math.clamp(y, 8, math.max(8, size.Y - 560 * self.scale.Scale - 8)))
    if self.ctx.dirty then self.ctx.dirty() end
end
function UI:SetVisible(open)
    self.open, self.window.Visible, self.shield.Visible = open, open, open
    if not open and self.cancelDrag then self.cancelDrag() end
    if self.ctx.visibility then self.ctx.visibility(open) end
end
function UI:Contains(point)
    if not self.open then return false end
    local p, s = self.window.AbsolutePosition, self.window.AbsoluteSize
    return point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y
end
