        end

        active:connect(originalAnimator.AnimationPlayed,function(track) mirror(track,true) end)
        local playing=originalAnimator:GetPlayingAnimationTracks()
        local equipping=false
        for _,track in ipairs(playing) do mirror(track) if track.Animation and track.Animation.Name:lower()=="equip" then equipping=true end end
        if not equipping and selected.equip then local equip=load(selected.equip) equip.Priority=Enum.AnimationPriority.Action equip:Play(0.05) end



        local templateHands=table.clone(hands)
        local joints={}
        local liveIndex=Models.observe(original,active)
        local cssIndex=css and Models.observe(css,active)
        local cssJoints={}
        local function bindHands()
            if not css then return end
            local changed=cssIndex.dirty
            local skinParts,objects=cssIndex:read()
            if changed then
                table.clear(cssJoints)
                for _,joint in ipairs(objects) do
                    if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then table.insert(cssJoints,joint) end
                end
            end
            if #skinParts==0 then return end
            table.clear(hands)
            for _,part in ipairs(skinParts) do
                if not Models.isHelper(part) then table.insert(hands,part) end
            end
            for _,driver in ipairs(templateHands) do ctx.layers:set(owner,driver,"LocalTransparencyModifier",1,100) end
            for _,joint in ipairs(cssJoints) do
                if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
                    local bindings=joints[joint]
                    if not bindings then bindings={} joints[joint]=bindings end
                    for _,key in ipairs({"Part0","Part1"}) do
                        local part=joint[key]
                        if part and part:IsDescendantOf(original) and not part:IsDescendantOf(css) then
                            local target=clone:FindFirstChild(part.Name,true)
                            if target and target:IsA("BasePart") then bindings[key]=target end
                        end
                        if bindings[key] then ctx.layers:set(owner,joint,key,bindings[key],100) end
                    end
                end
            end
            for joint in pairs(joints) do
                if not joint:IsDescendantOf(css) then ctx.layers:forget(owner,joint) joints[joint]=nil end
            end
        end
        ctx.adapter.overrides.weapon,ctx.adapter.overrides.hands=weapon,hands
        local function place()
            if originalRoot.Parent and root.Parent then


                root.CFrame=originalRoot.CFrame*CFrame.Angles(0,math.rad(ctx.config.knife.yaw),0)
            end
        end
        ctx.placeKnife=place
        local function follow()
            if not original.Parent or not originalRoot.Parent then return end
            syncScale()
            place()
            bindHands()
            for _,part in ipairs(liveIndex:read()) do
                if not Models.isHelper(part) and not (css and part:IsDescendantOf(css)) then
                    ctx.layers:set(owner,part,"LocalTransparencyModifier",1,100)
                end
            end
            local present={}
            for _,track in ipairs(originalAnimator:GetPlayingAnimationTracks()) do
                present[track]=true
                local entry=mirror(track)
                local copy=entry and entry.copy
                if copy and not entry.inspect then
                    local ratio=track.Length>0 and copy.Length>0 and copy.Length/track.Length or 1
                    copy:AdjustSpeed(track.Speed*ratio)
                    copy:AdjustWeight(track.WeightCurrent,0.04)
                    local desired=track.TimePosition*ratio
                    if math.abs(copy.TimePosition-desired)>0.04 then copy.TimePosition=desired end
                end
            end
            for track,entry in pairs(mirrors) do
                if not present[track] then

                    if entry.copy and not entry.inspect then entry.copy:Stop(0.05) end
                    mirrors[track]=nil
                end
            end
        end
        follow()
        active:render(ctx.run,follow,2051)
        return true
    end
    local function update()
        local camera=workspace.CurrentCamera
        local original=camera and camera:FindFirstChild("Arms")
        if not ctx.adapter:isKnife() or not original then if active then clear() end return end
        if original~=live or original:FindFirstChild("CSSArms")~=css then
            local called,ok,reason=pcall(attach,original)
            if not called then ctx.stop("knife","The selected knife rig could not initialize its animations.")
            elseif not ok then ctx.stop("knife",reason) end
        end
    end
    scope:render(ctx.run,update,2050)
    return true
end
return AnimatedKnife

end)()

local Cosmetics = (function()
